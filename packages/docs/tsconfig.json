{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@frame/core": [
        "../core/src/index.ts"
      ],
      "@frame/themes": [
        "../themes/src/index.ts"
      ],
      "@frame/core/modules/*": [
        "../core/src/modules/*/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
