{
  "name": "frame",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:library": "vite build --config vite.library.config.ts && vue-tsc -p tsconfig.library.json && bun scripts/check-library-boundary.ts",
    "check:consumer": "vue-tsc -p tsconfig.consumer.json --noEmit"
  },
  "dependencies": {
    "@iconify-json/codicon": "^1.2.75",
    "@iconify/vue": "^5.0.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5",
    "@tauri-apps/cli": "^2"
  },
  "main": "./packages/frame/dist/frame.js",
  "types": "./packages/frame/dist/types/frame/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/frame/dist/types/frame/index.d.ts",
      "import": "./packages/frame/dist/frame.js"
    },
    "./style.css": "./packages/frame/dist/frame.css"
  },
  "files": [
    "packages/frame/dist",
    "THIRD_PARTY_NOTICES.md",
    "public/licenses"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
